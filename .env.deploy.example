# Optional GHCR auth (required if package visibility is private).
# GHCR_USERNAME=<github-username-or-service-user>
# GHCR_TOKEN=<github-token-with-read:packages>

# Option A: define a single GHCR repo prefix and use prod-latest tags.
# GHCR_REPOSITORY=ghcr.io/<owner>/<repo>

# Option B: set full image references explicitly.
# BACKEND_IMAGE=ghcr.io/<owner>/<repo>-backend:prod-latest
# CADDY_IMAGE=ghcr.io/<owner>/<repo>-caddy:prod-latest

# Optional compose file overrides.
# COMPOSE_FILE=compose.proxmox.yaml
# COMPOSE_IMAGE_FILE=compose.proxmox.images.yaml

# Optional deployed service list.
# DEPLOY_SERVICES="backend caddy cloudflared"

# Optional healthcheck URL to fail fast if rollout is unhealthy.
# HEALTHCHECK_URL=https://<your-domain>/healthz

